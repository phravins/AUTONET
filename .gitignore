# Rust
/target
**/*.rs.bk

# Hardware acceptance runs (scripts/macos-acceptance.sh, windows-acceptance.ps1).
# Evidence, not source: raw command output from one machine on one network,
# including MAC addresses, since the scripts ask for `-v`. The one artefact meant
# to be kept is the capture each copies into
# tests/fixtures/{macos,windows}-real-*.json.
/acceptance

# Nix
result
result-*
.direnv/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Release archives, when the packaging steps in .github/workflows/release.yml
# are rehearsed by hand. They are build output that happens to land in the
# repository root rather than under target/, and a stray 4 MB binary is an easy
# thing to commit by accident.
/autonet-*.tar.gz
/autonet-*.zip
/autonet-*-*/
/SHA256SUMS
